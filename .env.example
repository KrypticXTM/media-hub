# Required: password for the Login page (owner only)
ADMIN_PASSWORD=change-me-to-something-long

# Required: random secret to sign the session cookie
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional: site title in the header
NEXT_PUBLIC_SITE_NAME=Tim's Media Hub

# Optional: Formspree form endpoint for Feedback / Report bug
# Create a form at https://formspree.io and paste the full URL, e.g.
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxx
# Point Formspree notifications to your private inbox (e.g. Tutamail).
# If unset, product pages show “Feedback coming soon” instead of a live form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
